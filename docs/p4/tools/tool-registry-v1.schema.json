{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lia.invalid/contracts/tools/tool-registry-v1.schema.json",
  "title": "LIA Tool Registry Entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool_id",
    "schema_version",
    "title",
    "description",
    "capability",
    "input_schema_uri",
    "output_schema_uri",
    "permission",
    "execution",
    "data_governance",
    "lifecycle"
  ],
  "properties": {
    "tool_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "schema_version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "usage_constraints": { "type": "array", "items": { "type": "string", "maxLength": 500 } },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "capability_schema_version", "adapter_class", "operation_type", "resource_types"],
      "properties": {
        "capability_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "capability_schema_version": { "type": "integer", "minimum": 1 },
        "adapter_class": { "type": "string", "minLength": 1, "maxLength": 120 },
        "operation_type": { "type": "string", "enum": ["observe", "subscribe", "control", "configure", "verify"] },
        "resource_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "input_schema_uri": { "type": "string", "format": "uri-reference" },
    "output_schema_uri": { "type": "string", "format": "uri-reference" },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_scopes", "minimum_risk_tier", "confirmation_policy"],
      "properties": {
        "required_scopes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "minimum_risk_tier": { "type": "string", "enum": ["R0", "R1", "R2", "R3", "R4"] },
        "confirmation_policy": { "type": "string", "enum": ["never", "when_policy_requires", "always", "owner_defined"] },
        "purpose_constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotency_class", "maximum_attempts", "reconciliation_method", "verification_method", "cancellation_points"],
      "properties": {
        "side_effect_class": { "type": "string", "enum": ["read_only", "local_mutation", "external_mutation", "physical_effect", "configuration_change"] },
        "idempotency_class": { "type": "string", "enum": ["idempotent_target_state", "provider_idempotency_key", "deduplicate_by_operation_id", "non_idempotent"] },
        "maximum_attempts": { "type": "integer", "minimum": 1, "maximum": 20 },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "reconciliation_method": { "type": "string", "minLength": 1, "maxLength": 160 },
        "verification_method": { "type": "string", "minLength": 1, "maxLength": 160 },
        "cancellation_points": { "type": "array", "items": { "type": "string" } }
      }
    },
    "data_governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_sensitivity", "locality", "retention_class", "provider_egress_allowed"],
      "properties": {
        "maximum_sensitivity": { "type": "string", "enum": ["S0", "S1", "S2", "S3"] },
        "locality": { "type": "string", "enum": ["local_only", "approved_region", "any_approved_region"] },
        "retention_class": { "type": "string", "enum": ["transient", "task_scoped", "approved_persistent"] },
        "provider_egress_allowed": { "type": "boolean" },
        "egress_policy_id": { "type": ["string", "null"], "maxLength": 160 }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "introduced_in", "deprecated"],
      "properties": {
        "state": { "type": "string", "enum": ["active", "deprecated", "disabled", "removed"] },
        "introduced_in": { "type": "string", "minLength": 1, "maxLength": 80 },
        "deprecated": { "type": "boolean" },
        "replacement_tool_id": { "type": ["string", "null"], "maxLength": 160 }
      }
    }
  }
}
